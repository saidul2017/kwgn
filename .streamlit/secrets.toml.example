# =============================================================================
# Streamlit Secrets - Template
# =============================================================================
# Cara setup di Streamlit Cloud:
#   1. Buka app di https://share.streamlit.io
#   2. Klik app Anda -> Settings -> Secrets
#   3. Salin baris di bawah (hapus tanda #) dan ganti placeholder dengan
#      Gemini API Key Anda dari https://aistudio.google.com/app/apikey
#   4. Klik Save -> app akan auto-restart
#
# Untuk pakai lokal:
#   - Salin file ini ke .streamlit/secrets.toml
#   - Isi dengan API key Anda
#   - JANGAN commit secrets.toml ke repo publik (sudah di-gitignore)
# =============================================================================

# GEMINI_API_KEY = "AIza...your-real-key-here..."
